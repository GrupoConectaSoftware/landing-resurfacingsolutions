---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import footerImage from '../../assets/footer/imagen-footer.webp'; 
import CustomerSupport from './customer-support.astro';
import ToastContainer from '../toast/toast-container.astro';

---

<footer id="site-footer" class="relative flex min-h-[115vh] w-full flex-col justify-end overflow-x-clip bg-white md:min-h-0 min-[800px]:landscape:min-h-[106vh] xl:min-h-[106vh]" role="contentinfo">
  <!-- Espacio de respiración móvil independiente de la altura del contenido oscuro -->
  <div class="h-[45vh] min-h-64 w-full shrink-0 bg-white md:hidden" aria-hidden="true"></div>

  <div class="min-h-[70vh] w-full bg-brand-charcoal text-brand-white md:min-h-0 min-[800px]:landscape:min-h-[76vh] xl:min-h-[76vh]">
  <!-- Banner fotográfico con corte diagonal -->
  <section id="footer-banner" class="relative hidden w-full overflow-hidden bg-white min-[800px]:landscape:-mb-px min-[800px]:landscape:block min-[800px]:landscape:aspect-1433/278 xl:-mb-px xl:block xl:aspect-1433/278">
    <div class="absolute inset-0 overflow-hidden min-[800px]:landscape:-bottom-0.5 xl:-bottom-0.5">
      <Image
        src={footerImage}
        alt="Interior surface restored by Resurfacing Solutions"
        class="absolute inset-0 h-full w-full object-cover"
        widths={[640, 960, 1440, 1920]}
        sizes="100vw"
        loading="lazy"
        decoding="async"
      />
      <div class="absolute inset-x-0 bottom-0 h-[58%] bg-[linear-gradient(to_bottom,transparent_0%,rgba(33,33,33,0.22)_30%,rgba(33,33,33,0.70)_68%,var(--color-brand-charcoal)_100%)] 2xl:h-[64%] 2xl:bg-[linear-gradient(to_bottom,transparent_0%,rgba(33,33,33,0.28)_26%,rgba(33,33,33,0.82)_66%,var(--color-brand-charcoal)_100%)]" aria-hidden="true"></div>
    </div>

    <div
      class="relative z-10 mx-auto flex w-full max-w-none flex-col items-start px-5 transition-all duration-1000 ease-out sm:px-6 lg:px-5 min-[800px]:landscape:absolute min-[800px]:landscape:inset-0 min-[800px]:landscape:justify-start min-[800px]:landscape:px-[4vw] min-[800px]:landscape:pt-[8vw] xl:absolute xl:inset-0 xl:justify-start xl:px-[4vw] xl:pt-[8vw] 2xl:pt-[8.5vw]"
    >
      <div class="w-full">
        <h2 class="text-3xl font-bold leading-none tracking-tight text-white sm:text-4xl md:whitespace-nowrap min-[800px]:landscape:text-[clamp(2.35rem,3.25vw,2.8rem)] lg:text-6xl xl:text-[clamp(2.35rem,3.25vw,2.8rem)] 2xl:text-[clamp(2.75rem,3.9vw,3.75rem)]">
          Your surface does not need replacement
        </h2>
        <p class="mt-1.5 font-secondary text-3xl italic leading-none text-brand-red sm:text-4xl md:whitespace-nowrap min-[800px]:landscape:text-[clamp(2.35rem,3.25vw,2.8rem)] lg:text-6xl xl:text-[clamp(2.35rem,3.25vw,2.8rem)] 2xl:mt-2 2xl:text-[clamp(2.75rem,3.9vw,3.75rem)]">
          It only needs the right restoration
        </p>
      </div>
    </div>
  </section>

  <!-- Información principal -->
  <div
    class="mx-auto w-full max-w-375 px-5 pb-7 pt-10 transition-all duration-1000 ease-out sm:px-6 sm:pb-8 sm:pt-12 min-[800px]:landscape:max-w-7xl min-[800px]:landscape:pb-0 min-[800px]:landscape:pt-20 lg:px-5 lg:pt-18 xl:max-w-7xl xl:pb-0 xl:pt-20"
  >
    <div class="grid grid-cols-1 gap-10 pb-12 sm:grid-cols-2 sm:gap-x-12 md:grid-cols-3 md:gap-x-8 min-[800px]:landscape:grid-cols-[1.35fr_0.55fr_1.1fr_0.8fr] min-[800px]:landscape:gap-[clamp(2rem,3.5vw,4rem)] min-[800px]:landscape:pb-[clamp(1.75rem,3.5vh,2.75rem)] min-[800px]:landscape:[&_a]:text-[clamp(0.68rem,0.78vw,0.82rem)] min-[800px]:landscape:[&_h3]:mb-[0.9rem] min-[800px]:landscape:[&_h3]:text-[0.65rem] min-[800px]:landscape:[&_li+li]:mt-[0.45rem] lg:grid-cols-[1.4fr_0.65fr_1.15fr_0.9fr] lg:gap-6 lg:pb-16 xl:grid-cols-[1.35fr_0.55fr_1.1fr_0.8fr] xl:gap-[clamp(2rem,3.5vw,4rem)] xl:pb-[clamp(1.75rem,3.5vh,2.75rem)] xl:[&_a]:text-[clamp(0.68rem,0.78vw,0.82rem)] xl:[&_h3]:mb-[0.9rem] xl:[&_h3]:text-[0.65rem] xl:[&_li+li]:mt-[0.45rem]">
      <div class="max-w-xl sm:col-span-2 md:col-span-3 min-[800px]:landscape:col-span-1 lg:col-span-1">
        <p class="font-secondary text-3xl italic text-white min-[800px]:landscape:text-[clamp(1.45rem,1.8vw,2rem)] xl:text-[clamp(1.45rem,1.8vw,2rem)]">Resurfacing Solutions</p>
        <p class="mt-6 text-base leading-relaxed text-white/75 sm:text-lg min-[800px]:landscape:mt-4 min-[800px]:landscape:text-[clamp(0.72rem,0.85vw,0.9rem)] min-[800px]:landscape:leading-[1.55] lg:text-base xl:mt-4 xl:text-[clamp(0.72rem,0.85vw,0.9rem)] xl:leading-[1.55]">
          Restore the beauty, strength, and value of your natural stone and concrete surfaces. Our team provides professional restoration, polishing, repair, and maintenance solutions with meticulous attention to detail and results built to last.
        </p>
      </div>

      <nav aria-label="Footer navigation">
        <h3 class="mb-5 text-xs font-bold uppercase tracking-[0.18em] text-brand-red">Navigation</h3>
        <ul class="space-y-3">
          <li><a href="/#site-top" class="inline-block text-sm text-white/70 transition-all duration-200 hover:translate-x-1 hover:text-brand-red">Home</a></li>
          <li><a href="/about/about/" class="inline-block text-sm text-white/70 transition-all duration-200 hover:translate-x-1 hover:text-brand-red">About</a></li>
          <li><a href="/gallery/gallery/" class="inline-block text-sm text-white/70 transition-all duration-200 hover:translate-x-1 hover:text-brand-red">Gallery</a></li>
          <li><a href="/contact/contact/" class="inline-block text-sm text-brand-red transition-all duration-200 hover:translate-x-1">Contact</a></li>
        </ul>
      </nav>

      <nav aria-label="Services">
        <h3 class="mb-5 text-xs font-bold uppercase tracking-[0.18em] text-brand-red">Services</h3>
        <ul class="space-y-3">
          <li><a href="/gallery/gallery/#project-gallery" class="inline-block text-sm leading-relaxed text-white/70 transition-all duration-200 hover:translate-x-1 hover:text-brand-red lg:whitespace-nowrap">Surface Restoration and Refinishing</a></li>
          <li><a href="/gallery/gallery/#project-gallery" class="inline-block text-sm leading-relaxed text-white/70 transition-all duration-200 hover:translate-x-1 hover:text-brand-red lg:whitespace-nowrap">Honing and Polishing</a></li>
          <li><a href="/gallery/gallery/#project-gallery" class="inline-block text-sm leading-relaxed text-white/70 transition-all duration-200 hover:translate-x-1 hover:text-brand-red lg:whitespace-nowrap">Cleaning and Sealing</a></li>
          <li><a href="/gallery/gallery/#project-gallery" class="inline-block text-sm leading-relaxed text-white/70 transition-all duration-200 hover:translate-x-1 hover:text-brand-red lg:whitespace-nowrap">Crack, Chip, and Joint Repair</a></li>
          <li><a href="/gallery/gallery/#project-gallery" class="inline-block text-sm leading-relaxed text-white/70 transition-all duration-200 hover:translate-x-1 hover:text-brand-red lg:whitespace-nowrap">Concrete Polishing</a></li>
          <li><a href="/gallery/gallery/#project-gallery" class="inline-block text-sm leading-relaxed text-white/70 transition-all duration-200 hover:translate-x-1 hover:text-brand-red lg:whitespace-nowrap">Maintenance Programs</a></li>
        </ul>
      </nav>

      <nav aria-label="Privacy and support">
        <h3 class="mb-5 text-xs font-bold uppercase tracking-[0.18em] text-brand-red">Privacy</h3>
        <ul class="space-y-3">
          <li><a href="/legal/privacy-policy/" class="inline-block text-sm text-white/70 transition-all duration-200 hover:translate-x-1 hover:text-brand-red">Privacy Policy</a></li>
          <li><a href="/legal/terms-and-conditions/" class="inline-block text-sm text-white/70 transition-all duration-200 hover:translate-x-1 hover:text-brand-red">Terms and Conditions</a></li>
          <li><a href="/#faq" class="inline-block text-sm text-white/70 transition-all duration-200 hover:translate-x-1 hover:text-brand-red">Frequently Asked Questions</a></li>
        </ul>
      </nav>
    </div>

    <div class="flex w-full flex-col gap-5 border-t border-white/20 py-5 sm:flex-row sm:items-center sm:justify-between min-[800px]:landscape:grid min-[800px]:landscape:grid-cols-[minmax(0,1fr)_auto] min-[800px]:landscape:items-center min-[800px]:landscape:gap-8 min-[800px]:landscape:py-4 xl:grid xl:grid-cols-[minmax(0,1fr)_auto] xl:items-center xl:gap-8 xl:py-4">
      <p class="whitespace-nowrap text-[9px] font-medium tracking-normal text-white/65 sm:text-xs sm:tracking-wider min-[800px]:landscape:m-0 min-[800px]:landscape:text-left xl:m-0 xl:text-left">
        © {new Date().getFullYear()} Resurfacing Solutions. All rights reserved
      </p>

      <div class="flex items-center gap-1 min-[800px]:landscape:justify-self-end xl:mr-5 xl:justify-self-end" aria-label="Social media">
        <a href="https://instagram.com/resurfacing.solutions" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="grid h-8 w-8 place-items-center text-white/70">
          <Icon name="mdi:instagram" class="text-xl" aria-hidden="true" />
        </a>
        <a href="https://wa.me/18186180574" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="grid h-8 w-8 place-items-center text-white/70">
          <Icon name="mdi:whatsapp" class="text-xl" aria-hidden="true" />
        </a>
        <a href="https://facebook.com/resurfacing" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="grid h-8 w-8 place-items-center text-white/70">
          <Icon name="mdi:facebook" class="text-xl" aria-hidden="true" />
        </a>
      </div>
    </div>
  </div>
  </div>

  <ToastContainer />
  <CustomerSupport />

  <button
    x-data="{ theme: document.documentElement.classList.contains('dark') ? 'dark' : 'light' }"
    @click="
      theme = theme === 'dark' ? 'light' : 'dark';
      document.documentElement.classList.toggle('dark', theme === 'dark');
      localStorage.setItem('resurfacing-theme', theme);
      window.dispatchEvent(new CustomEvent('resurfacing:theme-change', { detail: { theme } }));
    "
    class="fixed bottom-19 right-5 z-60 hidden h-11 w-11 place-items-center rounded-full bg-brand-charcoal text-white shadow-lg ring-1 ring-white/15 transition hover:-translate-y-1 hover:bg-brand-red active:scale-95 sm:right-6 min-[800px]:landscape:grid! xl:grid"
    type="button"
    :aria-label="theme === 'dark' ? 'Activate light mode' : 'Activate dark mode'"
    :title="theme === 'dark' ? 'Light mode' : 'Dark mode'"
  >
    <Icon x-cloak x-show="theme === 'light'" name="mdi:weather-night" class="text-xl" aria-hidden="true" />
    <Icon x-cloak x-show="theme === 'dark'" name="mdi:white-balance-sunny" class="text-xl" aria-hidden="true" />
  </button>

  <button
    x-data="{
      show: false,
      init() {
        window.addEventListener('scroll', () => { this.show = window.scrollY > 500; }, { passive: true });
      },
      scrollToTop() {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    }"
    x-show="show"
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="translate-y-4 opacity-0"
    x-transition:enter-end="translate-y-0 opacity-100"
    x-transition:leave="transition ease-in duration-200"
    x-transition:leave-start="translate-y-0 opacity-100"
    x-transition:leave-end="translate-y-4 opacity-0"
    @click="scrollToTop()"
    class="fixed bottom-19 right-5 z-60 grid h-11 w-11 place-items-center rounded-full bg-brand-red text-white shadow-lg transition-transform hover:-translate-y-1 active:scale-95 sm:bottom-20 sm:right-6 min-[800px]:landscape:bottom-33! xl:bottom-33"
    aria-label="Back to top"
  >
    <Icon name="mdi:arrow-up" class="text-xl" aria-hidden="true" />
  </button>
</footer>
