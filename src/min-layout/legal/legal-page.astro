---
interface LegalSection {
  title: string;
  paragraphs?: string[];
  items?: string[];
}

interface Props {
  eyebrow: string;
  title: string;
  introduction: string;
  updated: string;
  sections: LegalSection[];
}

const { eyebrow, title, introduction, updated, sections } = Astro.props;
---

<main class="overflow-x-clip bg-white text-brand-charcoal">
  <header class="relative isolate overflow-hidden bg-brand-charcoal px-5 py-20 text-white sm:px-8 sm:py-24 lg:px-12 lg:py-28">
    <div class="pointer-events-none absolute inset-0 -z-10 bg-[linear-gradient(to_right,rgba(255,255,255,0.045)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.045)_1px,transparent_1px)] bg-size-[46px_46px] mask-[linear-gradient(to_bottom,black,transparent)]" aria-hidden="true"></div>
    <div class="mx-auto max-w-6xl">
      <p class="text-[10px] font-bold uppercase tracking-[0.22em] text-brand-red">{eyebrow}</p>
      <h1 class="mt-4 max-w-4xl text-4xl font-bold leading-[1.02] tracking-[-0.04em] sm:text-5xl lg:text-6xl">{title}</h1>
      <p class="mt-6 max-w-3xl text-sm leading-7 text-white/70 sm:text-base">{introduction}</p>
      <p class="mt-6 text-xs font-semibold uppercase tracking-[0.14em] text-white/45">Last updated: {updated}</p>
    </div>
  </header>

  <article class="mx-auto grid max-w-6xl gap-12 px-5 py-16 sm:px-8 sm:py-20 lg:grid-cols-[14rem_minmax(0,1fr)] lg:px-12 lg:py-24">
    <aside class="lg:sticky lg:top-40 lg:self-start" aria-label="Legal document contact">
      <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-brand-red">Questions?</p>
      <p class="mt-3 text-sm leading-6 text-brand-charcoal/60">We are available to clarify how this policy applies to your interaction with Resurfacing Solutions.</p>
      <a href="mailto:info@resurfacingsolutions.services" class="mt-5 inline-flex break-all text-xs font-semibold text-brand-charcoal underline decoration-brand-red decoration-2 underline-offset-4">info@resurfacingsolutions.services</a>
    </aside>

    <div class="space-y-12">
      {sections.map((section, index) => (
        <section aria-labelledby={`legal-section-${index + 1}`} class="border-t border-brand-charcoal/10 pt-8 first:border-t-0 first:pt-0">
          <h2 id={`legal-section-${index + 1}`} class="text-2xl font-bold tracking-[-0.025em] sm:text-3xl">{section.title}</h2>
          {section.paragraphs?.map((paragraph) => <p class="mt-4 text-sm leading-7 text-brand-charcoal/65 sm:text-base">{paragraph}</p>)}
          {section.items && (
            <ul class="mt-5 space-y-3 pl-5 text-sm leading-7 text-brand-charcoal/65 marker:text-brand-red sm:text-base">
              {section.items.map((item) => <li class="list-disc pl-1">{item}</li>)}
            </ul>
          )}
        </section>
      ))}
    </div>
  </article>
</main>
