---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import desktopLogo from "../../assets/navegation/imagen-logo.webp";
import mobileLogo from "../../assets/navegation/imagen-logoM.webp";
import translations from "../../i18n/translations.json";
---

<script is:inline>
  (() => {
    const storedTheme = localStorage.getItem('resurfacing-theme');
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    document.documentElement.classList.toggle('dark', storedTheme ? storedTheme === 'dark' : prefersDark);
  })();
</script>

<script is:inline define:vars={{ translations }}>
  window.__RS_TRANSLATIONS__ = translations;
</script>

<!-- Contenedor de Mneu de Navegacion -->
<header
  id="site-top"
  class="sticky top-0 z-[2147483647] isolate w-full shrink-0 overflow-x-clip font-primary transition-transform duration-400 ease-out will-change-transform"
  role="banner"
  x-data="{
    visible: true,
    previousY: 0,
    ready: false,
    locale: localStorage.getItem('resurfacing-locale') || 'es',
    translations: window.__RS_TRANSLATIONS__ || { es: {}, en: {} },
    englishIndex: {},
    translationObserver: null,
    theme: document.documentElement.classList.contains('dark') ? 'dark' : 'light',
    init() {
      this.visible = true;
      this.previousY = Math.max(window.scrollY, 0);
      this.locale = ['es', 'en'].includes(this.locale) ? this.locale : 'es';
      this.englishIndex = Object.fromEntries(
        Object.entries(this.translations.en || {}).map(([key, value]) => [this.normalizeText(value), key])
      );
      document.documentElement.lang = this.locale;

      requestAnimationFrame(() => {
        this.previousY = Math.max(window.scrollY, 0);
        this.ready = true;
        this.translateDocument();
      });

      this.translationObserver = new MutationObserver((mutations) => {
        if (mutations.some((mutation) => mutation.addedNodes.length || mutation.type === 'characterData')) {
          requestAnimationFrame(() => this.translateDocument());
        }
      });
      this.translationObserver.observe(document.body, { childList: true, subtree: true, characterData: true });

      window.addEventListener('pageshow', () => {
        this.visible = true;
        this.previousY = Math.max(window.scrollY, 0);
      });

      window.addEventListener('resurfacing:theme-change', (event) => {
        this.theme = event.detail?.theme || (document.documentElement.classList.contains('dark') ? 'dark' : 'light');
      });
    },
    normalizeText(value) {
      return String(value || '').replace(/\s+/g, ' ').trim();
    },
    t(key) {
      return this.translations[this.locale]?.[key] ?? this.translations.en?.[key] ?? key;
    },
    toggleLanguage() {
      this.locale = this.locale === 'es' ? 'en' : 'es';
      localStorage.setItem('resurfacing-locale', this.locale);
      document.documentElement.lang = this.locale;
      this.translateDocument();
      window.dispatchEvent(new CustomEvent('resurfacing:locale-change', { detail: { locale: this.locale } }));
    },
    translateDocument() {
      const root = document.body;
      if (!root) return;

      const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
      let node;
      while ((node = walker.nextNode())) {
        const parent = node.parentElement;
        if (!parent || ['SCRIPT', 'STYLE', 'NOSCRIPT', 'TEXTAREA'].includes(parent.tagName)) continue;

        let key = node.__rsI18nKey;
        if (!key) {
          key = this.englishIndex[this.normalizeText(node.nodeValue)];
          if (key) node.__rsI18nKey = key;
        }
        if (!key) continue;

        const translated = this.t(key);
        if (node.nodeValue !== translated) node.nodeValue = translated;
      }

      root.querySelectorAll('[placeholder], [title], [aria-label]').forEach((element) => {
        element.__rsI18nAttrs ||= {};
        ['placeholder', 'title', 'aria-label'].forEach((attribute) => {
          if (!element.hasAttribute(attribute)) return;
          let key = element.__rsI18nAttrs[attribute];
          if (!key) {
            key = this.englishIndex[this.normalizeText(element.getAttribute(attribute))];
            if (key) element.__rsI18nAttrs[attribute] = key;
          }
          if (key) element.setAttribute(attribute, this.t(key));
        });
      });
    },
    toggleTheme() {
      this.theme = this.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.classList.toggle('dark', this.theme === 'dark');
      localStorage.setItem('resurfacing-theme', this.theme);
      window.dispatchEvent(new CustomEvent('resurfacing:theme-change', { detail: { theme: this.theme } }));
    },
    updateVisibility() {
      if (!this.ready) return;

      const currentY = Math.max(window.scrollY, 0);
      const movement = currentY - this.previousY;

      if (currentY <= this.$el.offsetHeight) {
        this.visible = true;
      } else if (movement > 6) {
        this.visible = false;
      } else if (movement < -4) {
        this.visible = true;
      }

      this.previousY = currentY;
    }
  }"
  @scroll.window.throttle.80ms="updateVisibility()"
  :class="visible ? 'translate-y-0' : '-translate-y-full'"
>
  <!-- Barra superior: servicios, utilidades y redes -->
  <div class="navigation-service-strip h-10 bg-brand-black text-brand-white min-[800px]:landscape:h-10 xl:h-7 2xl:h-10">
    <div
      class="mx-auto flex h-full max-w-7xl items-center justify-between gap-3 px-4 sm:px-6 lg:px-8"
    >
      <div
        class="relative h-5 min-w-0 flex-1 overflow-hidden text-xs font-medium"
        x-data="{
          current: 0,
          visible: true,
          services: [
            'Natural Stone Restoration & Surface Renewal',
            'Professional Surface Polishing & Protection',
            'Stone Repair, Sealing & Maintenance',
            'Custom Stone Finishes & Detailing',
            'Commercial & Residential Stone Care',
            'Eco-Friendly Cleaning & Restoration'
          ],
          schedule() {
            setTimeout(() => {
              this.visible = false;
              setTimeout(() => {
                this.current = (this.current + 1) % this.services.length;
                this.visible = true;
                setTimeout(() => this.schedule(), 700);
              }, 800);
            }, 5000);
          },
          init() { this.schedule(); }
        }"
        aria-live="polite"
      >
        <span
          class="absolute inset-0 flex items-center truncate"
          x-show="visible"
          x-transition:enter="transition transform ease-out duration-700"
          x-transition:enter-start="translate-y-full opacity-0"
          x-transition:enter-end="translate-y-0 opacity-100"
          x-transition:leave="transition transform ease-in duration-700"
          x-transition:leave-start="translate-y-0 opacity-100"
          x-transition:leave-end="-translate-y-full opacity-0"
          x-text="services[current]"
          >Natural Stone Restoration &amp; Surface Renewal</span
        >
      </div>

      <div
        class="topbar-utilities hidden shrink-0 items-center gap-3 text-xs font-semibold md:flex min-[800px]:landscape:flex! lg:gap-5 xl:flex!"
      >
        <button
          type="button"
          class="topbar-utility-link hidden text-white/70 transition hover:text-white min-[800px]:landscape:inline! lg:inline xl:inline!"
          @click="toggleLanguage()"
          x-text="locale === 'es' ? t('language.switch_to_en') : t('language.switch_to_es')"
        >Translate to English</button>
        <a href="/#faq" class="topbar-utility-link hidden transition-opacity hover:opacity-70 min-[800px]:landscape:inline! lg:inline xl:inline!"
          >Frequently Asked Questions</a
        >

        <div class="flex items-center gap-3" aria-label="Social media">
          <a
            href="https://instagram.com/resurfacing.solutions"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="grid place-items-center text-base transition-opacity hover:opacity-70"
          >
            <Icon name="mdi:instagram" class="text-base" aria-hidden="true" />
          </a>
          <a
            href="https://wa.me/18186180574"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp"
            class="grid place-items-center text-base transition-opacity hover:opacity-70"
          >
            <Icon name="mdi:whatsapp" class="text-base" aria-hidden="true" />
          </a>
          <a
            href="https://facebook.com/resurfacing"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
            class="grid place-items-center text-base transition-opacity hover:opacity-70"
          >
            <Icon name="mdi:facebook" class="text-base" aria-hidden="true" />
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Barra de contacto y promociones -->
  <div
    class="navigation-contact-strip hidden h-8 border-b border-brand-gray-medium bg-brand-gray-light text-brand-charcoal md:block min-[800px]:landscape:block! min-[800px]:landscape:h-8 xl:block! xl:h-6 2xl:h-8"
  >
    <div
      class="mx-auto flex h-full max-w-7xl items-center justify-between gap-4 overflow-hidden px-4 text-xs font-medium sm:px-6 lg:px-8"
    >
      <div class="flex min-w-0 items-center gap-4 lg:gap-5">
        <a
          href="tel:+18186180574"
          class="flex shrink-0 cursor-default items-center gap-1.5"
          aria-label="Call +1 818 618 0574"
        >
          <Icon name="mdi:phone" class="text-sm" aria-hidden="true" />
          <span>+1 (818) 618-0574</span>
        </a>
        <a
          href="mailto:info@resurfacingsolutions.services"
          class="contact-email hidden min-w-0 cursor-default items-center gap-1.5 sm:flex min-[800px]:landscape:flex! xl:flex!"
        >
          <Icon
            name="mdi:email-outline"
            class="shrink-0 text-sm"
            aria-hidden="true"
          />
          <span class="truncate">info@resurfacingsolutions.services</span>
        </a>
        <span class="contact-hours hidden shrink-0 items-center gap-1.5 md:flex min-[800px]:landscape:flex! xl:flex!">
          <Icon name="mdi:clock-outline" class="text-sm" aria-hidden="true" />
          <span>7am to 6pm</span>
        </span>
      </div>

      <div class="contact-promo hidden min-w-0 flex-1 overflow-hidden min-[800px]:landscape:block! lg:block xl:block!">
        <div
          class="relative h-5 w-full"
          x-data="{
            current: 0,
            visible: true,
            banners: [
              'Lasting solutions for surfaces ready to be renewed.',
              'Transforming spaces with quality and experience.',
              'More than 10 years of surface restoration excellence.',
              'Committed to your satisfaction and the environment.'
            ],
            schedule() {
              setTimeout(() => {
                this.visible = false;
                setTimeout(() => {
                  this.current = (this.current + 1) % this.banners.length;
                  this.visible = true;
                  setTimeout(() => this.schedule(), 1000);
                }, 1100);
              }, 5000);
            },
            init() { this.schedule(); }
          }"
          aria-live="polite"
        >
          <span
            class="absolute inset-0 flex items-center justify-end text-xs"
            x-show="visible"
            x-transition:enter="transition transform ease-out duration-1000"
            x-transition:enter-start="-translate-x-full opacity-0"
            x-transition:enter-end="translate-x-0 opacity-100"
            x-transition:leave="transition transform ease-in duration-1000"
            x-transition:leave-start="translate-x-0 opacity-100"
            x-transition:leave-end="translate-x-full opacity-0"
            x-text="banners[current]"
            >Lasting solutions for surfaces ready to be renewed.</span
          >
        </div>
      </div>
    </div>
  </div>

  <!-- Navegación principal -->
  <nav
    class="main-navigation relative z-50 h-24 w-full overflow-visible bg-brand-red text-brand-white min-[800px]:landscape:h-28 min-[800px]:landscape:overflow-hidden xl:h-28 xl:overflow-hidden 2xl:h-36"
    aria-label="Main navigation"
    x-data="{ isOpen: false }"
  >
    <!-- El panel oscuro solo existe desde tablet -->
    <div
      class="navigation-panel absolute left-0 top-0 hidden h-32 w-1/2 bg-brand-charcoal [clip-path:polygon(0%_0%,100%_0%,85%_100%,0%_100%)] min-[800px]:landscape:block! min-[800px]:landscape:h-26 xl:block! xl:h-26 2xl:h-32"
      aria-hidden="true"
    >
    </div>

    <div
      class="relative z-20 mx-auto flex h-full w-full max-w-7xl items-center justify-between gap-4 px-4 pb-5 sm:px-6 lg:px-8"
    >
      <a
        href="/"
        class="desktop-brand relative z-30 flex min-w-0 items-center md:w-96 md:shrink-0 min-[800px]:landscape:w-72 min-[800px]:landscape:justify-center xl:w-96 xl:justify-center"
        aria-label="Resurfacing Solutions home page"
      >
        <Image
          src={mobileLogo}
          alt="Resurfacing Solutions"
          class="mobile-navigation-logo h-12 w-auto max-w-44 object-contain sm:h-16 min-[800px]:landscape:hidden! xl:hidden!"
          loading="eager"
          decoding="async"
        />
        <Image
          src={desktopLogo}
          alt="Resurfacing Solutions"
          class="desktop-navigation-logo hidden h-20 w-auto object-contain min-[800px]:landscape:block! min-[800px]:landscape:h-16 xl:block! xl:h-16 2xl:h-20"
          loading="eager"
          decoding="async"
        />
      </a>

      <div
        class="desktop-navigation-links ml-auto hidden xl:pt-5 items-center justify-end gap-7 min-[800px]:landscape:flex! min-[800px]:landscape:gap-4 xl:flex! xl:gap-7"
      >
        <a
          href="/#site-top"
          class="text-sm font-bold uppercase tracking-wide text-brand-white transition-all duration-200 hover:text-white hover:[text-shadow:0_0_10px_rgba(255,255,255,0.9)]"
          >HOME</a
        >
        <a
          href="/about/about/"
          class="text-sm font-bold uppercase tracking-wide text-brand-white transition-all duration-200 hover:text-white hover:[text-shadow:0_0_10px_rgba(255,255,255,0.9)]"
          >ABOUT</a
        >
        <a
          href="/gallery/gallery/"
          class="text-sm font-bold uppercase tracking-wide text-brand-white transition-all duration-200 hover:text-white hover:[text-shadow:0_0_10px_rgba(255,255,255,0.9)]"
          >GALLERY</a
        >
        <a
          href="/contact/contact/"
          class="ml-2 flex h-12 items-center gap-3 whitespace-nowrap rounded-lg bg-brand-white px-4 text-sm font-bold text-brand-charcoal shadow-md transition-all duration-200 hover:-translate-y-0.5 hover:bg-brand-black hover:text-brand-white min-[800px]:landscape:h-10 min-[800px]:landscape:gap-2 min-[800px]:landscape:px-3 min-[800px]:landscape:text-xs lg:ml-5 lg:px-6 xl:h-12 xl:gap-3 xl:px-6 xl:text-sm"
          aria-label="Contact Resurfacing Solutions"
        >
          <Icon name="mdi:forum-outline" class="text-xl" aria-hidden="true" />
          <span>Talk to Us</span>
        </a>
      </div>

      <button
        type="button"
        class="mobile-navigation-toggle relative z-[110] ml-auto grid h-11 w-11 shrink-0 place-items-center rounded-md border border-white/80 text-3xl text-white shadow-sm transition-all duration-200 hover:border-white hover:bg-white/10 min-[800px]:landscape:hidden! xl:hidden!"
        @click="isOpen = !isOpen"
        :aria-expanded="isOpen"
        aria-controls="mobile-navigation"
        :aria-label="isOpen ? 'Close navigation menu' : 'Open navigation menu'"
      >
        <Icon
          x-show="!isOpen"
          name="mdi:menu"
          class="text-3xl text-white"
          aria-hidden="true"
        />
        <Icon
          x-show="isOpen"
          name="mdi:close"
          class="text-3xl text-white"
          aria-hidden="true"
        />
      </button>
    </div>

    <!-- Menú móvil desplegable debajo del nav -->
    <div
      id="mobile-navigation"
      x-cloak
      x-show="isOpen"
      x-transition:enter="transition transform ease-out duration-300"
      x-transition:enter-start="-translate-y-4 opacity-0"
      x-transition:enter-end="translate-y-0 opacity-100"
      x-transition:leave="transition transform ease-in duration-200"
      x-transition:leave-start="translate-y-0 opacity-100"
      x-transition:leave-end="-translate-y-4 opacity-0"
      class="mobile-navigation-panel absolute inset-x-0 top-full z-[100] flex w-full flex-col overflow-x-hidden bg-brand-white px-6 pb-7 pt-5 text-brand-charcoal shadow-xl min-[800px]:landscape:hidden! xl:hidden!"
    >
      <div class="mx-auto flex w-full max-w-sm flex-col">
        <a
          href="/#site-top"
          class="border-b border-red-300/40 py-4 text-left text-sm font-bold tracking-wide transition-all hover:bg-brand-red/5 hover:pl-2"
          @click="isOpen = false">HOME</a
        >
        <a
          href="/about/about/"
          class="border-b border-red-300/40 py-4 text-left text-sm font-bold tracking-wide transition-all hover:bg-brand-red/5 hover:pl-2"
          @click="isOpen = false">ABOUT</a
        >
        <a
          href="/gallery/gallery/"
          class="border-b border-red-300/40 py-4 text-left text-sm font-bold tracking-wide transition-all hover:bg-brand-red/5 hover:pl-2"
          @click="isOpen = false">GALLERY</a
        >
        <a
          href="/contact/contact/"
          class="border-b border-red-300/40 py-4 text-left text-sm font-bold tracking-wide transition-all hover:bg-brand-red/5 hover:pl-2"
          @click="isOpen = false">CONTACT</a
        >
        <a
          href="/#faq"
          class="border-b border-red-300/40 py-4 text-left text-sm font-bold tracking-wide transition-all hover:bg-brand-red/5 hover:pl-2"
          @click="isOpen = false">FREQUENTLY ASKED QUESTIONS</a
        >
        <button
          type="button"
          class="w-full border-b border-red-300/40 py-4 text-left text-sm font-bold tracking-wide text-brand-charcoal/65 transition-all hover:bg-brand-red/5 hover:pl-2"
          @click="toggleLanguage()"
          x-text="locale === 'es' ? t('language.switch_to_en') : t('language.switch_to_es')"
        >Translate to English</button>

        <button
          type="button"
          class="flex w-full items-center justify-between border-b border-red-300/40 py-4 text-left text-sm font-bold tracking-wide transition-all hover:bg-brand-red/5 hover:px-2"
          @click="toggleTheme()"
          :aria-label="theme === 'dark' ? 'Activate light mode' : 'Activate dark mode'"
        >
          <span x-text="theme === 'dark' ? 'LIGHT MODE' : 'DARK MODE'">DARK MODE</span>
          <Icon x-cloak x-show="theme === 'light'" name="mdi:weather-night" class="text-xl text-brand-red" aria-hidden="true" />
          <Icon x-cloak x-show="theme === 'dark'" name="mdi:white-balance-sunny" class="text-xl text-brand-red" aria-hidden="true" />
        </button>

        <a
          href="/contact/contact/"
          class="mb-6 mt-7 flex items-center justify-center gap-2 rounded-md bg-brand-black px-5 py-3 text-sm font-bold text-white shadow-md"
          @click="isOpen = false"
        >
          <Icon name="mdi:forum-outline" class="text-xl" aria-hidden="true" />
          <span>TALK TO US</span>
        </a>

        <div
          class="flex flex-col items-start gap-4 text-left text-sm text-brand-charcoal"
          aria-label="Contact information"
        >
          <a
            href="tel:+18186180574"
            class="flex items-center justify-start gap-2"
          >
            <Icon name="mdi:phone" class="text-lg" aria-hidden="true" />
            <span>+1 (818) 618-0574</span>
          </a>
          <a
            href="mailto:info@resurfacingsolutions.services"
            class="flex max-w-full items-center justify-start gap-2 break-all"
          >
            <Icon
              name="mdi:email-outline"
              class="shrink-0 text-lg"
              aria-hidden="true"
            />
            <span>info@resurfacingsolutions.services</span>
          </a>
          <span class="flex items-center justify-start gap-2">
            <Icon name="mdi:clock-outline" class="text-lg" aria-hidden="true" />
            <span>7am to 6pm</span>
          </span>
        </div>
      </div>
    </div>
  </nav>
</header>
