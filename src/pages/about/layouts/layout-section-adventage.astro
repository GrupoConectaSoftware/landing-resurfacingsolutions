---
const advantages = [
  {
    title: 'Personalized Assessment',
    description: 'Every project begins with a clear understanding of the surface, its current condition, and the result you genuinely need.'
  },
  {
    title: 'A Process Tailored to the Material',
    description: 'We do not apply generic solutions. We define the right treatment for the stone, concrete, and type of finish involved.'
  },
  {
    title: 'Respect for Your Property',
    description: 'We protect the surrounding work area and complete every intervention with organization, precision, and respect for your space.'
  },
  {
    title: 'Experience Built Through Real Work',
    description: 'Our expertise comes from real residential and commercial projects—not improvised processes or one-size-fits-all methods.'
  },
  {
    title: 'Results Designed to Last',
    description: 'We restore more than appearance. We work to recover the strength, performance, and service life of every surface.'
  }
];
---

<section
  class="relative isolate w-full overflow-hidden bg-white py-20 sm:py-24 lg:py-28 xl:py-32 2xl:py-36"
  aria-labelledby="about-advantages-title"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[48%] bg-[linear-gradient(to_right,rgba(33,33,33,0.022)_1px,transparent_1px),linear-gradient(to_bottom,rgba(33,33,33,0.022)_1px,transparent_1px)] bg-size-[42px_42px] mask-[linear-gradient(to_bottom,black_0%,black_38%,transparent_100%)] sm:bg-size-[52px_52px] lg:bg-size-[64px_64px]"
  ></div>

  <div class="mx-auto w-full max-w-6xl px-6 sm:px-10 lg:px-14 xl:px-16">
    <header class="max-w-4xl">
      <p class="mb-4 font-primary text-[10px] font-bold uppercase tracking-[0.18em] text-brand-red sm:text-xs">
        About Resurfacing Solutions
      </p>

      <h2
        id="about-advantages-title"
        class="font-primary text-[2.35rem] font-bold leading-[0.99] tracking-[-0.04em] text-brand-charcoal min-[430px]:text-[2.75rem] sm:text-[3.15rem] lg:text-[3.45rem] xl:text-[3.65rem]"
      >
        The difference shows<br />
        <span class="font-secondary font-normal italic tracking-normal text-brand-red">in every step of the process.</span>
      </h2>
    </header>

    <ol class="mt-14 max-w-4xl space-y-8 sm:mt-16 sm:space-y-9 lg:ml-6 lg:mt-20 lg:space-y-10 xl:ml-8">
      {advantages.map(({ title, description }) => (
        <li>
          <article class="grid grid-cols-[0.9rem_minmax(0,1fr)] items-start gap-4 sm:grid-cols-[1rem_minmax(0,1fr)] sm:gap-5">
            <span class="mt-1.5 h-3 w-3 rounded-full bg-brand-red shadow-[0_0_0_4px_rgba(215,43,43,0.08)] sm:h-3.5 sm:w-3.5" aria-hidden="true"></span>
            <div class="min-w-0">
              <h3 class="font-primary text-[10px] font-bold uppercase leading-snug tracking-[0.12em] text-brand-red sm:text-xs">
                {title}
              </h3>
              <p class="mt-2.5 max-w-3xl font-primary text-sm leading-[1.7] text-brand-gray sm:text-base lg:text-[1rem]">
                {description}
              </p>
            </div>
          </article>
        </li>
      ))}
    </ol>
  </div>
</section>
