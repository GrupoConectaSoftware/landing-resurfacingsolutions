---
import { Image } from 'astro:assets';
import machineImage from '../../../assets/about/sections/history/imagen-about.webp';
---

<section
  class="flex w-full items-center overflow-hidden bg-white py-16 sm:py-20 lg:min-h-svh lg:py-20 xl:py-24"
  aria-labelledby="about-history-title"
>
  <div class="mx-auto grid w-full max-w-7xl items-center gap-12 px-5 sm:px-8 lg:grid-cols-[0.94fr_1.06fr] lg:gap-14 lg:px-10 xl:gap-20">
    <div class="flex min-w-0 flex-col">
      <p class="mb-4 font-primary text-[10px] font-bold uppercase tracking-[0.18em] text-brand-red sm:text-xs">
        About Resurfacing Solutions
      </p>

      <h2
        id="about-history-title"
        class="max-w-2xl font-primary text-[2.55rem] font-bold leading-[0.96] tracking-[-0.045em] text-brand-charcoal min-[430px]:text-5xl sm:text-[3.35rem] lg:text-[3.55rem] xl:text-[3.8rem] 2xl:text-[4rem]"
      >
        We are the team<br />
        behind
        <span class="font-secondary font-normal italic tracking-normal text-brand-red">every</span><br />
        <span class="font-secondary font-normal italic tracking-normal text-brand-red">beautifully restored</span><br />
        <span class="font-secondary font-normal italic tracking-normal text-brand-red">surface.</span>
      </h2>

      <p class="mt-6 max-w-xl font-primary text-sm leading-[1.65] text-brand-gray sm:text-base lg:mt-7 lg:text-[1.02rem] xl:text-[1.08rem]">
        At Resurfacing Solutions, we believe a worn surface does not always need to be replaced. Our work
        begins by understanding the material, assessing its condition, and applying the right process to
        recover its appearance, strength, and value.
      </p>

      <div class="mt-8 grid grid-cols-2 gap-x-5 gap-y-4 sm:mt-10 sm:gap-x-8 sm:gap-y-5">
        <div class="flex min-h-20 flex-col justify-center border-l-[3px] border-brand-red pl-4 sm:min-h-21 sm:pl-5">
          <strong class="font-primary text-3xl font-bold leading-none tracking-tight text-brand-red sm:text-4xl">15+</strong>
          <span class="mt-1 font-primary text-sm text-brand-gray sm:text-base">Years</span>
        </div>

        <div class="flex min-h-20 flex-col justify-center border-l-[3px] border-brand-red pl-4 sm:min-h-21 sm:pl-5">
          <strong class="font-primary text-2xl font-bold leading-none tracking-tight text-brand-red sm:text-3xl">Los Angeles</strong>
          <span class="mt-1 font-primary text-sm text-brand-gray sm:text-base">Service area</span>
        </div>

        <div class="col-span-2 flex min-h-20 flex-col justify-center border-l-[3px] border-brand-red pl-4 sm:min-h-21 sm:pl-5">
          <strong class="font-primary text-2xl font-bold leading-none tracking-tight text-brand-red sm:text-3xl lg:text-[2rem]">
            Residential + Commercial
          </strong>
          <span class="mt-1 font-primary text-sm text-brand-gray sm:text-base">Projects we serve</span>
        </div>
      </div>
    </div>

    <figure
      data-reveal-image
      class="relative mx-auto w-full max-w-2xl overflow-hidden rounded-sm border-[3px] border-brand-charcoal bg-brand-charcoal shadow-[0_20px_50px_rgba(0,0,0,0.16)] lg:mx-0 lg:justify-self-end"
    >
      <Image
        src={machineImage}
        alt="Professional polishing machine restoring a stone countertop"
        class="aspect-[1.28] h-full w-full object-cover object-center transition-transform duration-700 ease-out hover:scale-[1.025]"
        widths={[640, 960, 1280, 1600]}
        sizes="(max-width: 1023px) 100vw, 52vw"
        quality={92}
        loading="lazy"
        decoding="async"
      />
    </figure>
  </div>
</section>
