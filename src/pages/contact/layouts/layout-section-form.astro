---
import { Icon } from 'astro-icon/components';
import FormContact from '../components/component-section-form.astro';

const contactDetails = [
  { label: 'Phone', value: '+1 (818) 618-0574', href: 'tel:+18186180574', icon: 'mdi:phone-outline' },
  { label: 'Email', value: 'info@resurfacingsolutions.services', href: 'mailto:info@resurfacingsolutions.services', icon: 'mdi:email-outline' },
  { label: 'Instagram', value: '@resurfacing.solutions', href: 'https://instagram.com/resurfacing.solutions', icon: 'mdi:instagram' },
  { label: 'Facebook', value: 'Resurfacing Solutions', href: 'https://facebook.com/stone.restorers', icon: 'mdi:facebook' },
];
---

<section class="relative isolate w-full overflow-hidden bg-white py-16 sm:py-20 lg:py-24" aria-labelledby="contact-form-title">
  <div class="pointer-events-none absolute inset-0 -z-10 bg-[linear-gradient(to_right,rgba(32,32,32,0.055)_1px,transparent_1px),linear-gradient(to_bottom,rgba(32,32,32,0.055)_1px,transparent_1px)] bg-size-[42px_42px] mask-[linear-gradient(to_bottom,transparent_0%,black_16%,black_78%,transparent_100%)]" aria-hidden="true"></div>

  <div class="mx-auto w-full max-w-344 px-5 sm:px-8 lg:px-10 xl:px-12">
    <header class="mb-9 max-w-3xl sm:mb-11">
      <p class="mb-3 font-primary text-[10px] font-bold uppercase tracking-[0.18em] text-brand-red">Request an Assessment</p>
      <h2 id="contact-form-title" class="font-primary text-3xl font-bold leading-tight tracking-[-0.035em] text-brand-charcoal sm:text-4xl lg:text-[2.65rem]">
        Tell us what your surface needs.
      </h2>
      <p class="mt-3 max-w-2xl font-primary text-sm leading-relaxed text-brand-charcoal/65 sm:text-base">
        Share a few details about your surface and the result you want. We will review your request and recommend the right process.
      </p>
    </header>

    <aside class="mb-12 sm:mb-14 lg:mb-16" aria-label="Contact details">
      <ul class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
        {contactDetails.map((item) => (
          <li>
            <a
              href={item.href}
              target={item.href.startsWith('http') ? '_blank' : undefined}
              rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              class="group flex h-full min-h-24 items-center gap-4 rounded-xl border border-black/8 bg-white/95 px-4 py-4 shadow-[0_8px_28px_rgba(0,0,0,0.045)] backdrop-blur-[2px] transition duration-300 hover:-translate-y-0.5 hover:border-brand-red/25 hover:shadow-[0_12px_32px_rgba(0,0,0,0.08)] dark:border-white/10 dark:bg-[#252525]/95"
            >
              <span class="grid size-11 shrink-0 place-items-center rounded-full bg-brand-red/6 text-brand-red transition-colors group-hover:bg-brand-red group-hover:text-white">
                <Icon name={item.icon} class="text-[1.35rem]" aria-hidden="true" />
              </span>
              <span class="min-w-0">
                <strong class="block font-primary text-xs font-semibold text-brand-charcoal">{item.label}</strong>
                <span class="mt-1 block wrap-break-word font-primary text-[0.68rem] leading-relaxed text-brand-charcoal/65 sm:text-xs">{item.value}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </aside>

    <div class="mx-auto min-w-0 max-w-5xl rounded-2xl border border-black/6 bg-white/92 p-5 shadow-[0_20px_65px_rgba(0,0,0,0.07)] backdrop-blur-sm dark:border-white/10 dark:bg-[#252525]/95 sm:p-8 lg:p-10">
      <FormContact />
    </div>

    <dl class="mx-auto mt-7 flex max-w-5xl flex-col items-start justify-center gap-4 px-1 text-brand-charcoal/55 sm:flex-row sm:items-center sm:gap-10" aria-label="Business availability">
      <div class="flex items-center gap-2.5">
        <Icon name="mdi:clock-outline" class="shrink-0 text-xl" aria-hidden="true" />
        <dt class="sr-only">Hours</dt>
        <dd class="font-primary text-sm">Monday-Saturday, 7am-6pm</dd>
      </div>
      <div class="hidden h-4 w-px bg-black/15 sm:block" aria-hidden="true"></div>
      <div class="flex items-center gap-2.5">
        <Icon name="mdi:map-marker-outline" class="shrink-0 text-xl" aria-hidden="true" />
        <dt class="sr-only">Service Area</dt>
        <dd class="font-primary text-sm">Serving Los Angeles County</dd>
      </div>
    </dl>
  </div>
</section>
