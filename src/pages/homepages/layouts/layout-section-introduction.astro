---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import backgroundImage from '../../../assets/homepages/sections/introduction/imagen-introduction.webp';
import carouselImage1 from '../../../assets/homepages/sections/introduction/carrusel/imagen-carrusel1.webp';
import carouselImage2 from '../../../assets/homepages/sections/introduction/carrusel/imagen-carrusel2.webp';
import carouselImage3 from '../../../assets/homepages/sections/introduction/carrusel/imagen-carrusel3.webp';
import carouselImage4 from '../../../assets/homepages/sections/introduction/carrusel/imagen-carrusel4.webp';
import carouselImage5 from '../../../assets/homepages/sections/introduction/carrusel/imagen-carrusel5.webp';
import carouselImage6 from '../../../assets/homepages/sections/introduction/carrusel/imagen-carrusel6.webp';
import carouselImage7 from '../../../assets/homepages/sections/introduction/carrusel/imagen-carrusel7.webp';

const carouselImages = [
  { src: carouselImage1, alt: 'Restored and polished marble floor' },
  { src: carouselImage2, alt: 'Restored natural stone surface' },
  { src: carouselImage3, alt: 'Dark floor with a glossy finish' },
  { src: carouselImage4, alt: 'Professional flooring after restoration' },
  { src: carouselImage5, alt: 'Polished finish on a residential surface' },
  { src: carouselImage6, alt: 'Renewed floor detail' },
  { src: carouselImage7, alt: 'Surface restored by Resurfacing Solutions' }
];
---

<section
  class="hero-introduction relative -mt-px box-border flex h-svh min-h-svh max-h-svh w-full min-w-0 items-center overflow-hidden bg-brand-dark py-14 md:py-12 lg:py-14 xl:-mt-40 xl:py-[clamp(1.25rem,3.2vh,2rem)] 2xl:-mt-54"
  aria-labelledby="introduction-title"
>
  <Image
    src={backgroundImage}
    alt="Restored dark stone surface"
    class="hero-background pointer-events-none absolute inset-0 block h-full! min-h-full! w-full max-h-none! object-cover object-center"
    widths={[640, 960, 1440, 1920]}
    sizes="100vw"
    quality={90}
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
  <div class="relative z-10 mx-auto w-full min-w-0 max-w-[100rem] px-5 sm:px-7 lg:px-10 xl:px-14">
    <div class="hero-grid grid min-w-0 grid-cols-1 items-center gap-12 lg:grid-cols-[minmax(0,45fr)_minmax(0,55fr)] lg:gap-5 xl:translate-y-20 xl:gap-6 2xl:translate-y-27 2xl:gap-8">
      <div class="hero-copy flex w-full min-w-0 max-w-full flex-col justify-center overflow-hidden">
        <p class="mb-4 font-primary text-[10px] font-bold lowercase tracking-[0.2em] text-brand-red sm:text-xs">
          Stone Restoration Specialists
        </p>

        <h1
          id="introduction-title"
          class="hero-title max-w-2xl font-primary text-4xl font-bold leading-[0.98] tracking-[-0.045em] text-white sm:text-5xl md:text-4xl lg:text-[2.8rem] xl:text-[clamp(2.75rem,3.55vw,3.05rem)]"
        >
          Restore the<br />
          surface.
          <span class="font-secondary font-normal italic tracking-normal text-brand-red">Preserve</span><br />
          <span class="font-secondary font-normal italic tracking-normal text-brand-red">the space.</span>
        </h1>

        <p class="hero-description mt-6 w-full max-w-xl font-primary text-sm leading-relaxed wrap-break-word text-white/70 sm:text-base md:text-sm lg:text-base xl:mt-[clamp(1rem,2.5vh,1.5rem)] xl:text-[0.925rem]">
          Professional restoration, refinishing, polishing, repair and maintenance for natural stone and
          concrete surfaces throughout Los Angeles County.
        </p>

        <div class="hero-actions mt-8 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center sm:gap-4 xl:mt-[clamp(1.25rem,3vh,2rem)]">
          <a
            href="/#services"
            class="inline-flex min-h-12 w-full max-w-full items-center justify-center gap-2.5 rounded-sm bg-white px-4 py-3 font-primary text-xs font-bold uppercase tracking-[0.07em] text-brand-charcoal shadow-lg transition-all duration-300 hover:scale-[1.03] hover:shadow-[0_0_22px_rgba(255,255,255,0.2)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-red focus-visible:ring-offset-2 focus-visible:ring-offset-black sm:w-auto sm:px-6"
          >
            <Icon name="mdi:tools" class="text-lg" aria-hidden="true" />
            Explore Services
          </a>

          <a
            href="/gallery/gallery/"
            class="inline-flex min-h-12 w-full max-w-full items-center justify-center gap-2.5 rounded-sm border border-white/70 bg-black/10 px-4 py-3 font-primary text-xs font-bold uppercase tracking-[0.07em] text-white shadow-lg backdrop-blur-sm transition-all duration-300 hover:scale-[1.03] hover:border-white hover:bg-white hover:text-brand-charcoal hover:shadow-[0_0_22px_rgba(255,255,255,0.15)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-black sm:w-auto sm:px-6"
          >
            <Icon name="mdi:play-circle-outline" class="text-lg" aria-hidden="true" />
            View Gallery
          </a>
        </div>
      </div>

      <div
        class="hero-gallery relative hidden h-[clamp(20rem,52vh,28rem)] w-[94%] min-w-0 justify-self-center lg:block xl:h-[clamp(20rem,calc(100svh-13.5rem),30rem)] xl:w-[90%] 2xl:h-135 2xl:w-[92%]"
        x-data="{
          currentIndex: 0,
          total: 7,
          intervalId: null,

          startRotation() {
            if (this.intervalId) return;
            this.intervalId = setInterval(() => {
              this.currentIndex = (this.currentIndex + 1) % this.total;
            }, 4000);
          },

          stopRotation() {
            if (!this.intervalId) return;
            clearInterval(this.intervalId);
            this.intervalId = null;
          },

          init() {
            this.startRotation();
          },

          destroy() {
            this.stopRotation();
          }
        }"
        @mouseenter="stopRotation()"
        @mouseleave="startRotation()"
        aria-label="Rotating gallery of restored surfaces"
      >
        <figure class="carousel-card-primary absolute left-0 top-1/2 z-20 h-[88%] w-[56%] -translate-y-1/2 -rotate-1 overflow-hidden rounded-sm border-2 border-white/90 bg-brand-charcoal shadow-[0_22px_55px_rgba(0,0,0,0.55)]">
          {carouselImages.map((image, index) => (
            <Image
              src={image.src}
              alt={image.alt}
              class="absolute inset-0 h-full w-full object-cover object-center"
              widths={[480, 640, 800]}
              sizes="40vw"
              quality={88}
              loading={index === 0 ? 'eager' : 'lazy'}
              decoding="async"
              x-show={`currentIndex === ${index}`}
              x-transition:enter="transition duration-700 ease-out"
              x-transition:enter-start="translate-x-6 scale-[1.03] opacity-0"
              x-transition:enter-end="translate-x-0 scale-100 opacity-100"
              x-transition:leave="transition duration-500 ease-in"
              x-transition:leave-start="translate-x-0 scale-100 opacity-100"
              x-transition:leave-end="-translate-x-6 scale-[0.98] opacity-0"
            />
          ))}
        </figure>

        <figure class="carousel-card-secondary absolute left-[57%] top-1/2 z-10 h-[70%] w-[25%] -translate-y-1/2 overflow-hidden rounded-sm border-2 border-white/90 bg-brand-charcoal shadow-[0_18px_42px_rgba(0,0,0,0.5)]">
          {carouselImages.map((image, index) => (
            <Image
              src={image.src}
              alt=""
              class="absolute inset-0 h-full w-full object-cover object-center"
              widths={[320, 480, 640]}
              sizes="18vw"
              quality={88}
              loading="lazy"
              decoding="async"
              x-show={`(currentIndex + 1) % total === ${index}`}
              x-transition:enter="transition duration-700 ease-out"
              x-transition:enter-start="translate-x-5 scale-[1.04] opacity-0"
              x-transition:enter-end="translate-x-0 scale-100 opacity-100"
              x-transition:leave="transition duration-500 ease-in"
              x-transition:leave-start="translate-x-0 opacity-100"
              x-transition:leave-end="-translate-x-5 opacity-0"
            />
          ))}
        </figure>

        <figure class="carousel-card-tertiary absolute right-0 top-1/2 z-0 h-[58%] w-[17%] -translate-y-1/2 rotate-1 overflow-hidden rounded-sm border-2 border-white/90 bg-brand-charcoal shadow-[0_14px_34px_rgba(0,0,0,0.45)]">
          {carouselImages.map((image, index) => (
            <Image
              src={image.src}
              alt=""
              class="absolute inset-0 h-full w-full object-cover object-center"
              widths={[240, 320, 480]}
              sizes="10vw"
              quality={88}
              loading="lazy"
              decoding="async"
              x-show={`(currentIndex + 2) % total === ${index}`}
              x-transition:enter="transition duration-700 ease-out"
              x-transition:enter-start="translate-x-4 scale-[1.05] opacity-0"
              x-transition:enter-end="translate-x-0 scale-100 opacity-100"
              x-transition:leave="transition duration-500 ease-in"
              x-transition:leave-start="translate-x-0 opacity-100"
              x-transition:leave-end="-translate-x-4 opacity-0"
            />
          ))}
        </figure>
      </div>
    </div>
  </div>
</section>

