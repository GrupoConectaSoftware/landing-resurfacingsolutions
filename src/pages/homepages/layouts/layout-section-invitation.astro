---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import invitationImage from '../../../assets/homepages/sections/invitation/imagen-invitation.webp';
---

<section
  class="relative flex min-h-105 w-full items-center overflow-hidden bg-brand-black py-16 sm:min-h-110 sm:py-20 lg:min-h-120"
  aria-labelledby="invitation-title"
>
  <Image
    src={invitationImage}
    alt="Dark natural stone surface"
    class="pointer-events-none absolute inset-0 h-full w-full object-cover object-center opacity-80"
    widths={[640, 960, 1440]}
    sizes="100vw"
    quality={90}
    loading="lazy"
    decoding="async"
  />


  <div
    class="relative z-10 mx-auto w-full max-w-5xl px-5 text-center sm:px-8"
  >
    <h2
      id="invitation-title"
      class="font-primary text-3xl font-bold leading-tight tracking-[-0.04em] text-white sm:text-4xl lg:text-5xl xl:text-[3.35rem]"
    >
      Ready to renew
      <span class="font-secondary font-normal italic tracking-normal text-brand-red">your surfaces?</span>
    </h2>

    <p class="mx-auto mt-5 max-w-3xl font-primary text-sm leading-relaxed text-white/80 sm:text-base lg:mt-6">
      Restore the beauty, strength, and value of your natural stone and concrete surfaces. Our team provides
      professional restoration, polishing, repair, and maintenance with meticulous attention to detail and
      results built to last.
    </p>

    <div class="mt-8 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center sm:gap-4 lg:mt-9">
      <a
        href="/contact/contact/"
        class="group inline-flex min-h-12 items-center justify-center gap-2.5 rounded-sm bg-white px-6 py-3 font-primary text-xs font-bold uppercase tracking-[0.08em] text-brand-charcoal shadow-lg transition-all duration-300 hover:-translate-y-0.5 hover:bg-brand-red hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-red focus-visible:ring-offset-2 focus-visible:ring-offset-black sm:min-w-52"
      >
        <Icon name="mdi:chat-processing-outline" class="text-lg" aria-hidden="true" />
        Contact Us Now
      </a>

      <a
        href="/gallery/gallery/"
        class="group inline-flex min-h-12 items-center justify-center gap-2.5 rounded-sm border border-white/80 bg-black/15 px-6 py-3 font-primary text-xs font-bold uppercase tracking-[0.08em] text-white backdrop-blur-sm transition-all duration-300 hover:-translate-y-0.5 hover:border-white hover:bg-white hover:text-brand-charcoal focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-black sm:min-w-52"
      >
        <Icon name="mdi:play-circle-outline" class="text-lg" aria-hidden="true" />
        View Gallery
      </a>
    </div>
  </div>
</section>
