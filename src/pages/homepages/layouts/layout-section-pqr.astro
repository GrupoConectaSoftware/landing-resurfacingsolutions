---
const questions = [
  {
    question: 'What types of surfaces do you restore?',
    answer: 'We work with marble, travertine, terrazzo, natural stone, and concrete. Before recommending a treatment, we assess the material, finish, and level of wear.'
  },
  {
    question: 'Does the entire surface need to be replaced?',
    answer: 'In many cases, no. Professional polishing, repair, sealing, or refinishing can recover the surface appearance and performance without complete replacement.'
  },
  {
    question: 'How do you prepare an estimate?',
    answer: 'We begin with photos and a description of the area. When needed, we perform an assessment to confirm dimensions, damage, material, and desired finish before presenting the proposal.'
  },
  {
    question: 'How long can the process take?',
    answer: 'Timing depends on the size, material, and treatment required. Smaller projects may be completed within a few days, and we provide a clear timeline before work begins.'
  },
  {
    question: 'How do you protect the space during the work?',
    answer: 'We isolate the work area, protect nearby surfaces, and maintain an organized process. Our goal is to work precisely while minimizing dust, debris, and disruption.'
  },
  {
    question: 'Is your work insured or guaranteed?',
    answer: 'Yes. Every project includes a workmanship guarantee. If something does not meet the agreed expectations, we review and correct it within the established warranty period.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: questions.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer }
  }))
};
---

<!-- CONTENEDOR PRINCIPAL DE LAS PREGUNTAS FRECUENTES -->
<section id="faq" class="w-full scroll-mt-36 bg-white py-20 sm:py-24 lg:scroll-mt-56 lg:py-28" aria-labelledby="faq-title">
  <div class="mx-auto w-full max-w-7xl px-5 sm:px-8 lg:px-10">
    <header class="max-w-4xl">
      <p class="mb-4 font-primary text-[10px] font-bold uppercase tracking-[0.18em] text-brand-red sm:text-xs">
        Frequently Asked Questions
      </p>
      <h2 id="faq-title" class="font-primary text-4xl font-bold leading-[0.98] tracking-tighter text-brand-charcoal sm:text-5xl lg:text-6xl">
        Before we begin,
        <span class="mt-1 block font-secondary font-normal italic tracking-normal text-brand-red">we answer your questions.</span>
      </h2>
    </header>

    <div class="mt-14 max-w-5xl space-y-9 sm:mt-16 sm:space-y-10 lg:ml-8 lg:mt-20 xl:ml-12">
      {questions.map(({ question, answer }) => (
        <article class="grid grid-cols-[1rem_1fr] gap-4 sm:grid-cols-[1.25rem_1fr] sm:gap-5">
          <span class="mt-0.5 h-3.5 w-3.5 rounded-full bg-brand-red sm:h-4 sm:w-4" aria-hidden="true"></span>
          <div>
            <h3 class="font-primary text-[11px] font-bold uppercase tracking-[0.11em] text-brand-red sm:text-xs">{question}</h3>
            <p class="mt-3 max-w-4xl font-primary text-sm leading-relaxed text-brand-gray sm:text-base lg:text-lg lg:leading-snug">{answer}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
