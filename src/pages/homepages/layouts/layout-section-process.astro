---
const steps = [
  {
    number: '01',
    title: 'Contact and photos',
    description: 'Send us photos of the surface and tell us what you need.'
  },
  {
    number: '02',
    title: 'Surface assessment',
    description: 'We assess the material, its condition, and the level of wear.'
  },
  {
    number: '03',
    title: 'Tailored recommendation',
    description: 'We define the best process for the surface and your desired finish.'
  },
  {
    number: '04',
    title: 'Professional restoration',
    description: 'We repair, polish, renew, and protect every surface with precision.'
  },
  {
    number: '05',
    title: 'Final review',
    description: 'We verify the result and provide practical care recommendations.'
  }
];
---

<section
  class="flex min-h-[65vh] w-full items-center bg-[#d1d1d1] py-12 sm:py-10 md:py-12 lg:py-14"
  aria-labelledby="process-title"
>
  <div class="mx-auto w-full max-w-7xl px-4 sm:px-5 md:px-6 lg:max-w-[100rem] lg:px-4 xl:px-5 2xl:px-6">
    <div class="max-w-3xl sm:mx-auto sm:text-center">
      <p class="mb-3 font-primary text-[10px] font-bold uppercase tracking-[0.22em] text-brand-red sm:text-xs">
        Our Process
      </p>

      <h2
        id="process-title"
        class="text-left font-primary text-[1.75rem] font-bold leading-[1.04] tracking-[-0.04em] text-brand-charcoal sm:text-center sm:text-3xl lg:text-4xl xl:text-[2.65rem]"
      >
        <span class="sm:block">A clear process, from assessment</span>
        <span class="sm:block">to the final finish.</span>
      </h2>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-x-3 gap-y-10 sm:mt-14 sm:grid-cols-2 sm:gap-x-7 sm:gap-y-12 md:mt-16 md:grid-cols-3 md:gap-x-7 md:gap-y-12 lg:mt-18 lg:grid-cols-5 lg:gap-x-7 lg:gap-y-0 xl:mt-20 xl:gap-x-9 2xl:gap-x-11">
      {steps.map((step) => (
        <article class="group flex min-w-0 flex-col transition-transform duration-300 ease-out md:hover:-translate-y-1">
          <div class="relative mb-3 hidden h-px w-full bg-brand-red/80 sm:block" aria-hidden="true">
            <span class="absolute -top-1 right-0 h-2 w-2 rounded-full border border-brand-red bg-[#d1d1d1] transition-colors duration-300 group-hover:bg-brand-red"></span>
          </div>

          <span class="font-primary text-5xl font-bold leading-none tracking-tighter text-brand-red sm:text-[3.25rem] md:text-4xl lg:text-5xl xl:text-[3.5rem]">
            {step.number}
          </span>

          <h3 class="mt-3 font-primary text-xs font-semibold leading-snug text-brand-red sm:text-[13px] md:mt-2.5 md:text-[9px] lg:text-[10px] xl:text-xs">
            {step.title}
          </h3>

          <p class="mt-2.5 max-w-72 font-primary text-xs leading-[1.7] text-brand-charcoal/80 sm:text-[13px] md:mt-2 md:text-[9px] md:leading-[1.65] lg:text-[10px] xl:text-[11px]">
            {step.description}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
