---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import beforeImage from '../../../assets/homepages/sections/result/imagen-result1.webp';
import afterImage from '../../../assets/homepages/sections/result/imagen-result2.webp';
---

<section
  class="w-full overflow-hidden bg-brand-dark py-16 sm:py-20 lg:py-24"
  aria-labelledby="results-title"
>
  <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
    <header class="mb-10 text-center sm:mb-12 lg:mb-14">
      <p class="mb-3 font-primary text-[10px] font-bold uppercase tracking-[0.2em] text-brand-red sm:text-xs">
        Proven Results
      </p>
      <h2
        id="results-title"
        class="font-primary text-3xl font-bold leading-tight tracking-[-0.04em] text-white sm:text-4xl lg:text-5xl"
      >
        Results that speak for themselves.
      </h2>
    </header>

    <div
      x-data="{
        position: 50,
        dragging: false,

        updatePosition(event) {
          const bounds = this.$refs.comparison.getBoundingClientRect();
          const nextPosition = ((event.clientX - bounds.left) / bounds.width) * 100;
          this.position = Math.min(100, Math.max(0, nextPosition));
        },

        startDragging(event) {
          this.dragging = true;
          this.$refs.comparison.setPointerCapture(event.pointerId);
          this.updatePosition(event);
        },

        stopDragging(event) {
          this.dragging = false;
          if (this.$refs.comparison.hasPointerCapture(event.pointerId)) {
            this.$refs.comparison.releasePointerCapture(event.pointerId);
          }
        },

        moveWithKeyboard(event) {
          const movement = event.shiftKey ? 10 : 2;
          if (event.key === 'ArrowLeft') this.position = Math.max(0, this.position - movement);
          if (event.key === 'ArrowRight') this.position = Math.min(100, this.position + movement);
          if (event.key === 'Home') this.position = 0;
          if (event.key === 'End') this.position = 100;
        }
      }"
      x-ref="comparison"
      class="relative mx-auto aspect-4/3 w-full max-w-5xl cursor-ew-resize touch-none select-none overflow-hidden border border-white/20 bg-brand-charcoal shadow-2xl sm:aspect-video lg:aspect-2/1"
      @pointerdown.prevent="startDragging($event)"
      @pointermove.prevent="if (dragging) updatePosition($event)"
      @pointerup="stopDragging($event)"
      @pointercancel="stopDragging($event)"
      @lostpointercapture="dragging = false"
    >
      <Image
        src={afterImage}
        alt="Floor after professional restoration"
        class="pointer-events-none absolute inset-0 h-full w-full object-cover object-center"
        width={644}
        quality={90}
        loading="lazy"
        decoding="async"
      />

      <span class="pointer-events-none absolute right-4 top-4 z-0 bg-brand-dark/65 px-2 py-1 font-secondary text-[10px] font-semibold uppercase tracking-[0.16em] text-white shadow-sm sm:right-6 sm:top-5 sm:text-xs">
        After
      </span>

      <div
        class="pointer-events-none absolute inset-0 z-10 overflow-hidden"
        :style="'clip-path: inset(0 ' + (100 - position) + '% 0 0)'"
      >
        <Image
          src={beforeImage}
          alt="Floor before restoration"
          class="absolute inset-0 h-full w-full object-cover object-center"
          width={644}
          quality={90}
          loading="lazy"
          decoding="async"
        />

        <span class="absolute left-4 top-4 z-10 bg-brand-dark/75 px-2 py-1 font-secondary text-[10px] font-semibold uppercase tracking-[0.16em] text-white shadow-sm sm:left-6 sm:top-5 sm:text-xs">
          Before
        </span>
      </div>

      <div
        class="pointer-events-none absolute inset-y-0 z-20 w-0.5 -translate-x-1/2 bg-brand-red shadow-[0_0_14px_rgba(215,43,43,0.55)]"
        :style="'left: ' + position + '%'"
        aria-hidden="true"
      ></div>

      <button
        type="button"
        role="slider"
        aria-label="Compare before and after"
        aria-valuemin="0"
        aria-valuemax="100"
        :aria-valuenow="Math.round(position)"
        class="absolute top-1/2 z-30 grid h-11 w-11 -translate-x-1/2 -translate-y-1/2 cursor-ew-resize place-items-center rounded-full border-2 border-brand-red bg-brand-dark text-brand-red shadow-xl transition-transform duration-200 hover:scale-105 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-brand-dark sm:h-12 sm:w-12"
        :style="'left: ' + position + '%'"
        @keydown.prevent="moveWithKeyboard($event)"
      >
        <Icon name="mdi:arrow-left-right" class="text-xl sm:text-2xl" aria-hidden="true" />
      </button>
    </div>

    <p class="mx-auto mt-5 max-w-6xl text-center font-primary text-xs text-white/55 sm:text-sm">
      Drag the control to compare before and after.
    </p>
  </div>
</section>
