---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import surfaceTexture from '../../../assets/homepages/sections/services/Imagen-services1.webp';
import polishedInterior from '../../../assets/homepages/sections/services/Imagen-services2.webp';
import maintenanceInterior from '../../../assets/homepages/sections/services/Imagen-services3.webp';
---

<section id="services" class="services-section relative isolate w-full scroll-mt-36 overflow-hidden bg-white py-16 sm:py-20 lg:scroll-mt-56 lg:py-28 xl:py-24 2xl:py-32 [@media(min-width:1280px)_and_(max-width:1535px)]:h-[120vh] [@media(min-width:1280px)_and_(max-width:1535px)]:max-h-[120vh] [@media(min-width:1280px)_and_(max-width:1535px)]:py-[clamp(2.25rem,4.5vh,3.25rem)]" aria-labelledby="services-title">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-0 h-[40%] bg-[linear-gradient(to_right,rgba(33,33,33,0.065)_1px,transparent_1px),linear-gradient(to_bottom,rgba(33,33,33,0.065)_1px,transparent_1px)] bg-size-[42px_42px] mask-[linear-gradient(to_bottom,black_0%,black_48%,transparent_100%)] sm:bg-size-[52px_52px] lg:bg-size-[64px_64px]"
  ></div>

  <div class="relative z-10 mx-auto w-full max-w-[112rem] px-5 sm:px-7 lg:px-10 xl:px-14">
    <header class="services-header grid items-end gap-8 lg:grid-cols-[1.35fr_0.9fr] lg:gap-16 xl:gap-x-20 2xl:gap-x-28 [@media(min-width:1280px)_and_(max-width:1535px)]:gap-x-16">
      <div>
        <p class="mb-3 font-primary text-[10px] font-bold uppercase tracking-[0.18em] text-brand-red sm:text-xs">
          Featured Services
        </p>
        <h2
          id="services-title"
          class="font-primary text-4xl font-bold leading-[0.98] tracking-tighter text-brand-charcoal sm:text-5xl lg:text-6xl xl:text-7xl [@media(min-width:1280px)_and_(max-width:1535px)]:text-[clamp(2.6rem,3.5vw,3.5rem)]"
        >
          Expertise applied to
          <span class="mt-1 block font-secondary font-normal italic tracking-normal text-brand-red">every surface.</span>
        </h2>
      </div>

      <p class="max-w-2xl font-primary text-sm leading-relaxed text-brand-gray sm:text-base lg:pb-1 lg:text-lg xl:text-xl xl:leading-snug [@media(min-width:1280px)_and_(max-width:1535px)]:text-[clamp(0.8rem,1.05vw,0.95rem)] [@media(min-width:1280px)_and_(max-width:1535px)]:leading-[1.5]">
        We never apply the same process to every material. Each service is tailored to the surface, its
        current condition, and the finish you want, delivering precise and lasting restoration designed for
        each individual space.
      </p>
    </header>

    <div class="services-grid services-grid-primary mt-12 grid grid-cols-1 gap-3 sm:mt-14 sm:grid-cols-2 sm:gap-4 lg:mt-16 lg:grid-cols-[1.9fr_0.6fr_0.6fr] lg:gap-3 xl:mt-14 xl:gap-5 2xl:mt-18 2xl:gap-6 [@media(min-width:1280px)_and_(max-width:1535px)]:mt-[clamp(1.75rem,3.5vh,2.5rem)] [@media(min-width:1280px)_and_(max-width:1535px)]:gap-4 [@media(min-width:1280px)_and_(max-width:1535px)]:[&>article]:min-h-[clamp(12rem,26vh,14.5rem)] [@media(min-width:1280px)_and_(max-width:1535px)]:[&>article]:p-[clamp(1.25rem,2.4vh,1.8rem)] [@media(min-width:1280px)_and_(max-width:1535px)]:[&_h3]:text-[clamp(1.25rem,1.7vw,1.7rem)] [@media(min-width:1280px)_and_(max-width:1535px)]:[&_p]:text-[clamp(0.7rem,0.86vw,0.82rem)] [@media(min-width:1280px)_and_(max-width:1535px)]:[&_p]:leading-[1.5] [@media(min-width:1280px)_and_(max-width:1535px)]:[&_.my-7]:my-4 [@media(min-width:1280px)_and_(max-width:1535px)]:[&_.mt-10]:mt-4 [@media(min-width:1280px)_and_(max-width:1535px)]:[&_.mt-6]:mt-4">
      <article class="group relative flex min-h-96 overflow-hidden rounded-md bg-brand-charcoal p-7 sm:col-span-2 sm:min-h-110 sm:p-10 lg:col-span-1 lg:min-h-105 xl:min-h-120 xl:p-14">
        <Image
          src={surfaceTexture}
          alt="Professionally restored surface texture"
          class="absolute inset-0 h-full w-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-[1.03]"
          widths={[640, 960, 1440]}
          sizes="(max-width: 1024px) 100vw, 60vw"
          quality={90}
          loading="lazy"
          decoding="async"
        />
        <div class="absolute inset-0 bg-linear-to-t from-black/85 via-black/35 to-black/10"></div>

        <div class="relative z-10 mt-auto max-w-4xl">
          <h3 class="font-primary text-3xl font-bold leading-[1.04] tracking-[-0.04em] text-white sm:text-4xl lg:text-4xl xl:text-5xl">
            Surface restoration<br class="hidden sm:block" /> and refinishing
          </h3>
          <div class="my-5 h-0.5 w-full max-w-xl bg-brand-red sm:my-6"></div>
          <p class="max-w-3xl font-primary text-sm leading-relaxed text-white/80 sm:text-base xl:text-lg">
            We restore shine, consistency, and service life to natural stone and concrete surfaces with
            precision and proven expertise.
          </p>
        </div>
      </article>

      <article class="group flex min-h-80 flex-col rounded-md bg-brand-gray-light p-7 transition-transform duration-300 hover:-translate-y-1 sm:min-h-96 lg:min-h-105 lg:p-6 xl:min-h-120 xl:p-9">
        <div class="h-1 w-12 bg-brand-red transition-all duration-300 group-hover:w-16"></div>
        <div class="mt-auto">
          <h3 class="font-primary text-2xl font-bold leading-tight tracking-[-0.04em] text-brand-charcoal lg:text-3xl">
            Honing<br />and polishing
          </h3>
          <p class="mt-6 font-primary text-sm leading-relaxed text-brand-charcoal/80 sm:text-base lg:text-sm xl:text-base">
            We remove dullness, marks, and minor imperfections to achieve a smoother, more consistent surface
            with the right level of shine.
          </p>
        </div>
      </article>

      <article class="group flex min-h-80 flex-col rounded-md bg-brand-charcoal p-7 transition-transform duration-300 hover:-translate-y-1 sm:min-h-96 lg:min-h-105 lg:p-6 xl:min-h-120 xl:p-9">
        <div class="h-1 w-12 bg-white transition-all duration-300 group-hover:w-16"></div>
        <div class="mt-auto">
          <h3 class="font-primary text-2xl font-bold leading-tight tracking-[-0.04em] text-white lg:text-3xl">
            Cleaning<br />and sealing
          </h3>
          <p class="mt-6 font-primary text-sm leading-relaxed text-white/65 sm:text-base lg:text-sm xl:text-base">
            We remove dirt, residue, and contaminants, then apply professional sealers that protect the
            surface and extend its service life.
          </p>
        </div>
      </article>
    </div>

    <div class="services-grid services-grid-secondary mt-3 grid grid-cols-1 gap-3 sm:mt-4 sm:grid-cols-2 sm:gap-4 lg:grid-cols-3 lg:gap-3 xl:mt-5 xl:gap-5 2xl:mt-6 2xl:gap-6 [@media(min-width:1280px)_and_(max-width:1535px)]:mt-4 [@media(min-width:1280px)_and_(max-width:1535px)]:gap-4 [@media(min-width:1280px)_and_(max-width:1535px)]:[&>article]:min-h-[clamp(12rem,26vh,14.5rem)] [@media(min-width:1280px)_and_(max-width:1535px)]:[&>article]:p-[clamp(1.25rem,2.4vh,1.8rem)] [@media(min-width:1280px)_and_(max-width:1535px)]:[&_h3]:text-[clamp(1.25rem,1.7vw,1.7rem)] [@media(min-width:1280px)_and_(max-width:1535px)]:[&_p]:text-[clamp(0.7rem,0.86vw,0.82rem)] [@media(min-width:1280px)_and_(max-width:1535px)]:[&_p]:leading-[1.5] [@media(min-width:1280px)_and_(max-width:1535px)]:[&_.my-7]:my-4 [@media(min-width:1280px)_and_(max-width:1535px)]:[&_.mt-10]:mt-4 [@media(min-width:1280px)_and_(max-width:1535px)]:[&_.mt-6]:mt-4">
      <article class="group flex min-h-90 flex-col rounded-md bg-brand-red p-7 text-white transition-transform duration-300 hover:-translate-y-1 sm:min-h-100 sm:p-9 lg:min-h-105 xl:p-12">
        <div class="h-1 w-12 bg-white transition-all duration-300 group-hover:w-16"></div>
        <h3 class="mt-auto max-w-[88%] text-left font-primary text-2xl font-bold leading-[1.05] tracking-[-0.04em] sm:ml-auto sm:mr-[8%] sm:max-w-[75%] sm:text-right sm:text-3xl lg:text-3xl xl:text-4xl">
          Crack, chip, and joint repair
        </h3>
        <div class="my-7 h-0.5 w-full bg-white/90"></div>
        <p class="font-primary text-sm leading-relaxed text-white/90 sm:text-base">
          We repair cracks, damaged edges, chips, and deteriorated joints to restore the surface's integrity,
          continuity, and appearance.
        </p>
      </article>

      <article class="group relative flex min-h-90 overflow-hidden rounded-md bg-brand-gray-light p-7 sm:min-h-100 sm:p-9 lg:min-h-105 xl:p-12">
        <Image
          src={polishedInterior}
          alt="Polished concrete floor in a commercial space"
          class="absolute inset-0 h-full w-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-[1.04]"
          widths={[480, 720, 960]}
          sizes="(max-width: 640px) 100vw, 34vw"
          quality={90}
          loading="lazy"
          decoding="async"
        />
        <div class="absolute inset-0 bg-linear-to-b from-white/90 via-white/75 to-brand-charcoal/15"></div>
        <div class="relative z-10 max-w-sm">
          <div class="h-1 w-12 bg-brand-red transition-all duration-300 group-hover:w-16"></div>
          <h3 class="mt-10 font-primary text-2xl font-bold leading-tight tracking-[-0.04em] text-brand-charcoal sm:text-3xl">
            Concrete<br />polishing
          </h3>
          <p class="mt-6 font-primary text-sm leading-relaxed text-brand-charcoal/85 sm:text-base">
            We refine the surface to create a consistent, durable, bright finish that is easy to maintain.
          </p>
        </div>
      </article>

      <article class="group flex min-h-90 flex-col rounded-md border border-brand-gray-medium bg-white p-7 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl sm:col-span-2 sm:min-h-100 sm:p-9 lg:col-span-1 lg:min-h-105 xl:p-10">
        <div class="h-1 w-1/2 bg-brand-red transition-all duration-300 group-hover:w-2/3"></div>

        <div class="mt-5 grid items-center gap-6 sm:grid-cols-[0.75fr_1.25fr] lg:grid-cols-1 xl:grid-cols-[0.8fr_1.2fr]">
          <div class="aspect-4/3 overflow-hidden bg-brand-gray-light">
            <Image
              src={maintenanceInterior}
              alt="Surface included in a maintenance program"
              class="h-full w-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105"
              widths={[320, 480, 640]}
              sizes="(max-width: 640px) 100vw, 20vw"
              quality={90}
              loading="lazy"
              decoding="async"
            />
          </div>

          <div>
            <h3 class="font-primary text-2xl font-bold leading-[1.05] tracking-[-0.04em] text-brand-gray sm:text-3xl">
              Maintenance Programs
            </h3>
            <div class="mt-5 h-1 w-12 bg-brand-red"></div>
          </div>
        </div>

        <p class="mt-6 font-primary text-sm leading-relaxed text-brand-gray sm:text-base">
          We design preventive plans that preserve the finish, reduce wear, and keep every surface in optimal
          condition.
        </p>

        <a
          href="/contact/contact/"
          class="mt-auto flex items-center gap-2 border-t border-brand-gray-medium pt-5 font-primary text-xs font-medium text-brand-gray transition-colors duration-300 hover:text-brand-red"
        >
          <Icon name="mdi:chevron-right" class="shrink-0 text-lg text-brand-red" aria-hidden="true" />
          Plans tailored to every need
        </a>
      </article>
    </div>
  </div>
</section>

